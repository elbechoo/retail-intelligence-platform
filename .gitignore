data/raw/
*.duckdb
*.duckdb.wal
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
__pycache__/
.venv/
venv/

# Parquet exported for Power BI. Generated by analysis/export_for_powerbi.py
# from the warehouse, so it is derived data like data/raw and the .duckdb file
# - 22 MB of it, and it would be stale the moment a model changed. The .pbip
# refreshes from these files locally; run the export before opening it.
powerbi/data/

# Power BI local state. .pbi/cache.abf is a binary copy of the loaded data
# (tens of MB) and localSettings.json is machine-specific. The TMDL and PBIR
# definitions next to them ARE committed - those are the model.
.pbi/

# Power BI's auto date/time tables. It generates one hidden calendar per date
# column unless the feature is switched off, which bloats the model and makes
# every diff unreadable. dim_date is the date table; these are redundant.
# Turn the feature off: File > Options and settings > Options > Current file >
# Data Load > uncheck "Auto date/time".
**/LocalDateTable_*.tmdl
**/DateTableTemplate_*.tmdl
