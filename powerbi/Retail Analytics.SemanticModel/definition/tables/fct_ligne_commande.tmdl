/// Grain: one attributable sale line
table fct_ligne_commande
	lineageTag: d710fca2-c2b5-4831-8683-e376559da6e8

	/// Revenue from attributable sale lines, GBP. Excludes unattributed invoices - use fct_commande for those.
	measure 'Total Revenue' = SUM ( fct_ligne_commande[montant] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 49b657e7-7c14-478e-a46e-d73498854f57

	/// Distinct invoices containing attributable sale lines.
	measure Orders = DISTINCTCOUNT ( fct_ligne_commande[commande_id] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 34517a89-55ab-4da0-81de-d6eb6d2757ac

	/// Distinct customers who bought in the current filter context.
	measure Customers = DISTINCTCOUNT ( fct_ligne_commande[client_id] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: b0321a89-59dc-446e-a158-70ba51520424

	/// Total units across attributable sale lines.
	measure 'Units Sold' = SUM ( fct_ligne_commande[quantite] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: c883dc5a-f276-4590-9624-2805a2545b4f

	/// DIVIDE, not /, so an empty filter context returns blank rather than an error.
	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Orders] )
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: 569f6397-86ac-44e0-964d-06f897ec2cad

	/// Revenue divided by distinct buying customers.
	measure 'Revenue per Customer' = DIVIDE ( [Total Revenue], [Customers] )
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: c86659c6-b282-4437-82b5-9e130ee0fce4

	/// Basket breadth: distinct products per invoice.
	measure 'Lines per Order' = DIVIDE ( COUNTROWS ( fct_ligne_commande ), [Orders] )
		formatString: #,##0.0
		displayFolder: Sales
		lineageTag: db1c94b8-eb9e-45c5-87e3-8d75ea592adb

	/// Customers with more than one order over their lifetime.
	measure 'Returning Customers' = CALCULATE ( DISTINCTCOUNT ( dim_client[client_id] ), dim_client[est_recurrent] = TRUE () )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 4b454dbd-e18f-4a50-8813-dbd3028c1cc4

	/// Share of customers who ordered more than once. High here because the buyers are mostly wholesale.
	measure 'Returning Customer Rate' = DIVIDE ( [Returning Customers], DISTINCTCOUNT ( dim_client[client_id] ) )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 34070277-04a8-4379-bb83-ff7bcd209183

	/// Requires dim_date to be marked as the date table.
	measure 'Revenue LY' = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date_complete] ) )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 5153a50b-5f0b-49c2-b082-68a45b03cc47

	/// Blank where there is no prior year - the data starts in December 2009.
	measure 'Revenue YoY %' = DIVIDE ( [Total Revenue] - [Revenue LY], [Revenue LY] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 5081a4ac-1de2-4763-8612-26b3ed513636

