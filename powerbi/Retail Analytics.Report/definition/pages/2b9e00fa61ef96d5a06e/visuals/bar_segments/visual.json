{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "bar_segments",
  "position": {
    "x": 800,
    "y": 160,
    "z": 5,
    "height": 250,
    "width": 460,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_rfm"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "fct_rfm.segment",
              "nativeQueryRef": "segment",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_ligne_commande"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fct_ligne_commande.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}